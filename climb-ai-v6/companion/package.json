{
  "name": "op-climb-companion",
  "version": "0.10.0",
  "private": true,
  "description": "OP CLIMB Windows companion for League tracking and TFT pre-game learning with post-game decision review.",
  "main": "electron/bootstrap.cjs",
  "type": "module",
  "scripts": {
    "tracker": "node src/main.mjs",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "desktop:plain": "electron .",
    "build:plain": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "tesseract.js": "7.0.0",
    "@tesseract.js-data/eng": "1.0.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.opclimb.companion",
    "productName": "OP CLIMB Companion",
    "artifactName": "OP-Climb-Companion-Setup.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Craggles2304/climb-ai/releases/download/companion-beta"
      }
    ],
    "protocols": [
      {
        "name": "OP CLIMB Companion Pairing",
        "schemes": [
          "opclimb"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "!electron/overlay.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main.mjs",
        "to": "tracker/main.mjs"
      },
      {
        "from": "src/in-game-recovery.mjs",
        "to": "tracker/in-game-recovery.mjs"
      },
      {
        "from": "src/pregame-normalizer.mjs",
        "to": "tracker/pregame-normalizer.mjs"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "node_modules/@tesseract.js-data/eng/4.0.0_best_int/eng.traineddata.gz",
        "to": "tessdata/eng.traineddata.gz"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OP CLIMB Companion",
      "uninstallDisplayName": "OP CLIMB Companion",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ]
  },
  "author": {
    "name": "OP CLIMB"
  }
}
